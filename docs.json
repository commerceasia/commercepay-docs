{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CommercePay",
  "colors": {
    "primary": "#5D40E6",
    "light": "#9546E9",
    "dark": "#5834E9"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          "docs/overview",
          {
            "group": "Get Started",
            "pages": [
              "docs/get-started",
              "docs/api-credentials",
              "docs/service-environments",
              "docs/request-headers",
              "docs/generate-signature"
            ]
          },
          {
            "group": "Payins",
            "pages": [
              "docs/direct-integration",
              "docs/hosted-session-checkout",
              "docs/card-integration",
              "docs/recurring-payments"
            ]
          },
          {
            "group": "Payouts",
            "pages": [
              "docs/payout-integration",
              "docs/payout-provider-channel",
              "docs/payout-test-account"
            ]
          },
          {
            "group": "Refunds",
            "pages": [
              "docs/refund-integration"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Authentication",
            "pages": [
              "POST /api/TokenAuth/Authenticate"
            ]
          },
          {
            "group": "Channel APIs",
            "pages": [
              "GET /api/services/app/Channel/GetTenantChannelsByCountry",
              "GET /api/services/app/Channel/GetProviderChannels"
            ]
          },
          {
            "group": "Payin APIs",
            "pages": [
              "api-reference/direct-integration-api-request-payment",
              "POST /api/services/app/PaymentGateway/InitialSession",
              "GET /api/services/app/PaymentGateway/Query"
            ]
          },
          {
            "group": "Saved Payment APIs",
            "pages": [
              "POST /api/services/app/PaymentGateway/AddSavePayment",
              "POST /api/services/app/PaymentGateway/CheckSavedPayment",
              "POST /api/services/app/PaymentGateway/RevokeTokenize"
            ]
          },
          {
            "group": "Payout APIs",
            "pages": [
              "api-reference/payout-api-requestpayout",
              "api-reference/payout-api-querywallets",
              "api-reference/payout-api-querywallethistories"
            ]
          },
          {
            "group": "Refund APIs",
            "pages": [
              "POST /api/services/app/PaymentGateway/RefundPayment",
              "GET /api/services/app/PaymentGateway/QueryRefund"
            ]
          },
          {
            "group": "All APIs",
            "openapi": "openapi.json"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/commercepay-logo-cropped.png",
    "dark": "/logo/commercepay-logo-cropped.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
